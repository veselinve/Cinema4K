//!DESC Cinema4K-AI 2x Depth-to-Space Super-Resolution (Unblurred Catmull-Rom)
//!HOOK MAIN
//!BIND MAIN
//!BIND c4k_subpix
//!SAVE C4K_2X
//!WIDTH MAIN.w 2 *
//!HEIGHT MAIN.h 2 *
//!COMPONENTS 4
float get_luma_recon(vec3 c) { return dot(c, vec3(0.2126, 0.7152, 0.0722)); }

vec3 sample_catmull_rom(vec2 pos, vec2 pt) {
    vec2 tc = pos / pt - 0.5;
    vec2 f = fract(tc);
    vec2 idx = floor(tc);
    vec2 w0 = f * (-0.5 + f * (1.0 - 0.5 * f));
    vec2 w1 = 1.0 + f * f * (-2.5 + 1.5 * f);
    vec2 w2 = f * (0.5 + f * (2.0 - 1.5 * f));
    vec2 w3 = f * f * (-0.5 + 0.5 * f);
    vec2 w12 = w1 + w2;
    vec2 off12 = w2 / max(w12, vec2(0.0001));
    vec2 p0  = (idx - vec2(0.5)) * pt;
    vec2 p12 = (idx + vec2(0.5) + off12) * pt;
    vec2 p3  = (idx + vec2(2.5)) * pt;
    vec3 col = vec3(0.0);
    col += MAIN_tex(vec2(p0.x,  p0.y)).rgb  * (w0.x  * w0.y);
    col += MAIN_tex(vec2(p12.x, p0.y)).rgb  * (w12.x * w0.y);
    col += MAIN_tex(vec2(p3.x,  p0.y)).rgb  * (w3.x  * w0.y);
    col += MAIN_tex(vec2(p0.x,  p12.y)).rgb * (w0.x  * w12.y);
    col += MAIN_tex(vec2(p12.x, p12.y)).rgb * (w12.x * w12.y);
    col += MAIN_tex(vec2(p3.x,  p12.y)).rgb * (w3.x  * w12.y);
    col += MAIN_tex(vec2(p0.x,  p3.y)).rgb  * (w0.x  * w3.y);
    col += MAIN_tex(vec2(p12.x, p3.y)).rgb  * (w12.x * w3.y);
    col += MAIN_tex(vec2(p3.x,  p3.y)).rgb  * (w3.x  * w3.y);
    return clamp(col, 0.0, 1.0);
}

vec4 hook() {
    vec2 pos_2x = MAIN_pos;
    vec2 f = fract(pos_2x * c4k_subpix_size);
    ivec2 sub_idx = ivec2(f * 2.0);
    vec2 lr_center = (vec2(0.5) - f) * c4k_subpix_pt + pos_2x;
    vec4 sub = c4k_subpix_tex(lr_center);
    int idx = sub_idx.y * 2 + sub_idx.x;
    float residual_y = (idx == 0) ? sub.x : ((idx == 1) ? sub.y : ((idx == 2) ? sub.z : sub.w));
    vec3 base_rgb = sample_catmull_rom(pos_2x, MAIN_pt);
    float base_y = get_luma_recon(base_rgb);
    float hr_y = clamp(base_y + residual_y * 1.85, 0.0, 1.0);
    vec3 out_rgb = (base_y > 0.0001) ? base_rgb * (hr_y / base_y) : base_rgb;
    return vec4(clamp(out_rgb, 0.0, 1.0), 1.0);
}

//!DESC Cinema4K-AI Final: Multi-Scale Optical Acutance (Hair & Fabric Wavelet)
//!HOOK MAIN
//!BIND MAIN
//!BIND C4K_2X
//!SAVE MAIN
//!WIDTH C4K_2X.w
//!HEIGHT C4K_2X.h
#define HAIR_BOOST 0.50
#define FABRIC_BOOST 0.40
float get_luma_f(vec3 c) { return dot(c, vec3(0.2126, 0.7152, 0.0722)); }
vec4 hook() {
    vec2 pos = MAIN_pos;
    vec2 pt = C4K_2X_pt;
    vec3 c = C4K_2X_tex(pos).rgb;
    float y = get_luma_f(c);
    
    // Scale 1 (1x pt: Sub-pixel micro acutance)
    float y_top1 = get_luma_f(C4K_2X_tex(pos + vec2( 0.0, -pt.y)).rgb);
    float y_bot1 = get_luma_f(C4K_2X_tex(pos + vec2( 0.0,  pt.y)).rgb);
    float y_l1   = get_luma_f(C4K_2X_tex(pos + vec2(-pt.x,  0.0)).rgb);
    float y_r1   = get_luma_f(C4K_2X_tex(pos + vec2( pt.x,  0.0)).rgb);
    float blur1  = (y * 4.0 + (y_top1 + y_bot1 + y_l1 + y_r1) * 2.0 + 
                   get_luma_f(C4K_2X_tex(pos + vec2(-pt.x, -pt.y)).rgb) +
                   get_luma_f(C4K_2X_tex(pos + vec2( pt.x, -pt.y)).rgb) +
                   get_luma_f(C4K_2X_tex(pos + vec2(-pt.x,  pt.y)).rgb) +
                   get_luma_f(C4K_2X_tex(pos + vec2( pt.x,  pt.y)).rgb)) / 16.0;
    float micro1 = y - blur1;
    
    // Scale 2 (2x pt: Hair strands, beard whiskers & textile weave scale)
    vec2 pt2 = pt * 2.0;
    float y_top2 = get_luma_f(C4K_2X_tex(pos + vec2( 0.0, -pt2.y)).rgb);
    float y_bot2 = get_luma_f(C4K_2X_tex(pos + vec2( 0.0,  pt2.y)).rgb);
    float y_l2   = get_luma_f(C4K_2X_tex(pos + vec2(-pt2.x,  0.0)).rgb);
    float y_r2   = get_luma_f(C4K_2X_tex(pos + vec2( pt2.x,  0.0)).rgb);
    float blur2  = (blur1 * 4.0 + (y_top2 + y_bot2 + y_l2 + y_r2) * 2.0 +
                   get_luma_f(C4K_2X_tex(pos + vec2(-pt2.x, -pt2.y)).rgb) +
                   get_luma_f(C4K_2X_tex(pos + vec2( pt2.x, -pt2.y)).rgb) +
                   get_luma_f(C4K_2X_tex(pos + vec2(-pt2.x,  pt2.y)).rgb) +
                   get_luma_f(C4K_2X_tex(pos + vec2( pt2.x,  pt2.y)).rgb)) / 16.0;
    float micro2 = blur1 - blur2;
    
    // Gradient computation for halo suppression
    float gx = ((y_r1 - y_l1) + 0.5 * (y_r2 - y_l2)) * 0.5;
    float gy = ((y_bot1 - y_top1) + 0.5 * (y_bot2 - y_top2)) * 0.5;
    float grad = sqrt(gx * gx + gy * gy);
    float halo_sup = 1.0 / (1.0 + 4.0 * grad);
    
    float boost = (micro1 * HAIR_BOOST + micro2 * FABRIC_BOOST) * halo_sup;
    
    float target_y = clamp(y + boost, 0.0, 1.0);
    vec3 out_rgb = (y > 0.0001) ? c * (target_y / y) : c;
    return vec4(clamp(out_rgb, 0.0, 1.0), 1.0);
}
